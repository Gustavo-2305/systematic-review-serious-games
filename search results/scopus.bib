	publisher = {JMIR Publications Inc.},
	issn = {22919279},
	language = {English},
	abbrev_source_title = {JMIR Serious Games},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 19; All Open Access; Gold Open Access; Green Open Access}
}

