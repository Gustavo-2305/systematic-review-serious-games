@CONFERENCE{Gutica2021471,
	author = {Gutica, Mirela},
	title = {Fostering High School Girls' Interest and Attainment in Computer Science},
	year = {2021},
	journal = {Annual Conference on Innovation and Technology in Computer Science Education, ITiCSE},
	pages = {471 - 477},
	doi = {10.1145/3430665.3456353},
	url = {https://www.scopus.com/pages/publications/85109030904?origin=resultslist},
	affiliations = {British Columbia Institute of Technology, Burnaby, BC, Canada},
	abstract = {Computing education and careers are male dominated. Identifying strategies to reduce this gender gap would create a more diverse and inclusive workforce, and would respond to the growing importance of computing and technology in our society. This paper presents an intervention designed and conducted in a post-secondary polytechnic institution aimed at inspiring and motivating computer science education among high school girls. Grounded in theory and related research, this intervention was designed to address aspects recognized as having relevance to girls. Using the expectancy-value theory of motivation developed by Eccles as a theoretical foundation, this study explores the intervention's impact on participants' interest and attainment in computer science. Twenty five students (nineteen girls) from local high schools participated in this pre-questionnaire, intervention, post-questionnaire quasi-experimental study. Participants were mentored by post-secondary students (at least one mentor for each pair of participants) through activities including writing an algorithm, coding, exploring an AR/VR technology and practicing programming skills with an educational game. Analysis of resulting data revealed that girls who participated in this study experienced a high level of enjoyment, increased interest, perceived positive learning gains, and were inspired by their post-secondary mentors. Post-questionnaire responses indicated that girls improved their ability beliefs and reduced their stereotypical views.  © 2021 ACM.},
	author_keywords = {ability beliefs; coding; expectancy-value theory of motivation; role models; spatial cognition; stereotypes; women in computer science},
	keywords = {Computation theory; Education computing; Engineering research; Motivation; Students; Surveys; Computer Science Education; Computing education; Educational game; Expectancy-value theory; High school; Learning gain; Programming skills; Theoretical foundations; Engineering education},
	publisher = {Association for Computing Machinery},
	issn = {1942647X},
	isbn = {978-145038214-4},
	language = {English},
	abbrev_source_title = {Annu. Conf. Innov. Technol. Comput. Sci. Educ. ITiCSE},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 8}
}

